{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/table-bro.angular-material",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "*.css",
      "input": "dist",
      "output": "dist"
    },
    {
      "glob": "**/*.scss",
      "input": "styles",
      "output": "styles"
    },
    {
      "glob": "THIRD_PARTY_NOTICES.md",
      "input": ".",
      "output": "."
    }
  ]
}
