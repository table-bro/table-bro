{
  "name": "@table-bro/mcp",
  "version": "1.1.0",
  "description": "Pixel-perfect Material data tables for Angular, and more. A Web Components table engine on top of existing UI components.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "table",
    "data-table",
    "angular",
    "web-components",
    "ai-coding-agents",
    "vibe-coding",
    "claude-code",
    "cursor",
    "codex",
    "github-copilot",
    "windsurf",
    "gemini-cli",
    "grok",
    "cline",
    "zed",
    "jetbrains-ai",
    "angular-material-table"
  ],
  "mcpName": "io.github.table-bro/table-bro",
  "author": "table-bro",
  "homepage": "https://table-bro.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/table-bro/table-bro.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/table-bro/table-bro/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "table-bro-mcp": "dist/server/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "check": "node scripts/check-generator.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "~5.8.3",
    "vitest": "^5.0.3"
  }
}
