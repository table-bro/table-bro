{
  "name": "table-bro-workspace",
  "private": true,
  "description": "Table, Bro: the core, the skins, the Angular packages and the MCP server",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/skins/bootstrap",
    "packages/skins/native",
    "packages/skins/angular-material",
    "packages/angular",
    "packages/mcp"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "build": "npm run build -w @table-bro/core && npm run build -w @table-bro/bootstrap -w @table-bro/native && npm run build:angular && npm run build -w @table-bro/mcp",
    "build:angular": "ng-packagr -p packages/angular/ng-package.json -c packages/angular/tsconfig.lib.prod.json && npm run build:material",
    "build:material": "node scripts/build-css.mjs packages/skins/angular-material table-bro.material && ng-packagr -p packages/skins/angular-material/ng-package.json -c packages/skins/angular-material/tsconfig.lib.prod.json",
    "check:arch": "node scripts/check-arch.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:install": "node scripts/check-install.mjs",
    "build:samples": "node scripts/build-samples.mjs",
    "docs:api": "typedoc",
    "check:mcp": "npm run check -w @table-bro/mcp",
    "lint": "eslint packages stand e2e scripts samples eslint-rules \"*.{js,mjs,ts}\"",
    "format": "eslint --fix packages stand e2e scripts samples eslint-rules \"*.{js,mjs,ts}\"",
    "lint:styles": "stylelint \"{packages,stand}/**/*.scss\"",
    "lint:styles:fix": "stylelint \"{packages,stand}/**/*.scss\" --fix",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/skins/bootstrap --noEmit && tsc -p packages/skins/native --noEmit && tsc -p packages/angular/tsconfig.lib.json --noEmit && tsc -p packages/skins/angular-material/tsconfig.lib.json --noEmit && tsc -p packages/mcp --noEmit && tsc -p tsconfig.json --noEmit && tsc -p stand --noEmit && tsc -p e2e --noEmit",
    "test": "npm run check:arch && npm run check:api && vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=packages/core/**/*.ts --coverage.include=packages/skins/*/js/**/*.ts --coverage.include=packages/angular/src/**/*.ts --coverage.include=packages/skins/angular-material/src/**/*.ts --coverage.exclude=**/*.spec.ts --coverage.exclude=**/dist/** --coverage.exclude=**/node_modules/** --coverage.reporter=text-summary --coverage.reporter=html --coverage.reportsDirectory=coverage",
    "test:mcp": "npm test -w @table-bro/mcp",
    "stand": "ng serve stand",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/cli": "~22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/elements": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.0.10",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "bootstrap": "^5.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "lightningcss": "^1.33.0",
    "ng-packagr": "^22.2.4",
    "postcss-scss": "^4.0.9",
    "publint": "^0.3.25",
    "rxjs": "~7.5.0",
    "sass": "^1.104.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.1",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^3.25.76",
    "zone.js": "^0.15.1"
  },
  "overrides": {
    "playwright": "1.63.0"
  }
}
